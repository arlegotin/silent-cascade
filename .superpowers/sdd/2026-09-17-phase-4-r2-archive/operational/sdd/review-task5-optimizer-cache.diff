+def test_offline_environment_derives_inductor_cache_and_ignores_ambient(tmp_path, monkeypatch):
+    from silent_cascade.train.pilot_offline import offline_environment
+
+    root = tmp_path / "child"
+    monkeypatch.setenv("TORCHINDUCTOR_CACHE_DIR", str(tmp_path / "ambient-cache"))
+    environment = offline_environment(root)
+    assert environment["TORCHINDUCTOR_CACHE_DIR"] == str(root.absolute() / "cache")
+
+
+def test_real_scalar_adamw_initializes_only_empty_cache_root(tmp_path):
+    run_writer_control(
+        """
+try:
+    import torch
+    parameter = torch.tensor(0.0, device='cpu', requires_grad=True)
+    optimizer = torch.optim.AdamW([parameter], lr=0.001, foreach=False, fused=False)
+except OfflineWriteDenied as error:
+    raise RuntimeError(str(error)) from None
+assert os.environ['TORCHINDUCTOR_CACHE_DIR'] == str(root / 'cache')
+assert optimizer.param_groups[0]['params'][0] is parameter
+cache = root / 'cache'
+assert cache.is_dir()
+assert list(cache.iterdir()) == []
+guard.assert_clear()
+""",
+        tmp_path / "child",
+    )
+
+
+@pytest.mark.parametrize("artifact", ["file", "directory"])
+def test_optimizer_cache_artifact_denials_latch(tmp_path, artifact):
+    operation, reason = {
+        "file": ("(cache / 'compiler.bin').write_bytes(b'x')", "writer"),
+        "directory": ("(cache / 'fxgraph').mkdir()", "path"),
+    }[artifact]
+    run_writer_control(
+        f"""
+cache = root / 'cache'
+cache.mkdir()
+with denied({reason!r}):
+    {operation}
+assert list(cache.iterdir()) == []
+""",
+        tmp_path / "child",
+    )
+
+
